{
  "name": "practice-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "type-check": "vue-tsc --noEmit",
    "build:analyze": "vite build --mode analyze",
    "build:report": "vite build --mode analyze && npx vite-bundle-analyzer dist",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && npm install",
    "clean": "rm -rf node_modules dist && npm install",
    "serve": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@vueuse/core": "^14.0.0",
    "element-plus": "^2.11.5",
    "fabric": "^6.7.1",
    "pinia": "^3.0.3",
    "three": "^0.180.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "globals": "^16.4.0",
    "prettier": "3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^2.2.0"
  }
}
