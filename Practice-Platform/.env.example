# 前端构建的环境变量模板
#
# 复制成 .env.development / .env.production 后按需修改。
# Vite 只把 VITE_ 开头的变量暴露给代码（import.meta.env.VITE_XXX）。
# 注意：这两个文件会进 git，别把密钥写进来。

# 站点根路径。
# 部署在域名根目录时留空或填 /；
# 部署在子路径（GitHub Pages 的 /仓库名/）时填 /仓库名/ —— 末尾的斜杠别漏。
VITE_BASE_PATH=/

# 后端接口地址。
# 留空则回退到 http://localhost:8083/api（见 src/utils/api.js）。
# 同源反代部署时填 /api；独立域名时填 https://你的域名/api。
VITE_APP_BASE_API=http://localhost:8083/api
