# 生产配置模板 —— 只覆盖与本地开发不同的项，其余沿用 application.properties。
#
# 用法：放到服务器上的仓库外（例如 /opt/calligraphy/application-production.properties），
# 启动时追加：
#   java -jar app.jar \
#     --spring.config.additional-location=file:/opt/calligraphy/application-production.properties
# **不要**复制进 src/main/resources/ —— 那样会被打进 jar 甚至提交进版本库。
#
# 密钥一律走环境变量占位符（${JWT_SECRET} / ${DB_PASSWORD}），
# 由 systemd / 容器注入，不明文落盘。本地开发的密钥模板见 config/local-secrets.properties.example。

# --- 数据库：生产 MySQL ---
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/calligraphy_practice?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.username=calligraphy
spring.datasource.password=${DB_PASSWORD}

# --- Redis ---
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379
# 没设密码就留空
spring.data.redis.password=${REDIS_PASSWORD:}

# --- CORS：同源反代（deploy/nginx-calligraphy.conf.example）下前端与 /api 同源，
# 跨域不会发生；改成正式域名是为了留一条跨域场景的通路。逗号分隔可写多个。 ---
app.cors.allowed-origins=https://your-domain.example

# --- 上传目录：生产用绝对路径，不随进程工作目录漂移 ---
file.upload-dir=/var/lib/calligraphy/uploads

# --- 日志 ---
logging.file.name=/var/log/calligraphy/app.log
