# 本地密钥模板 —— 复制成 local-secrets.properties 后填值。
#
# local-secrets.properties **已被 .gitignore 忽略**，绝不要提交。
# run-local.ps1 会把它读成环境变量注入进程（不回显），应用通过
# ${JWT_SECRET} / ${DB_PASSWORD} 占位符读取。
#
#   cp local-secrets.properties.example local-secrets.properties
#
# JWT 密钥建议用 64 位随机 hex（openssl rand -hex 32）。
# 注意：一旦这个密钥公开过，任何人都能伪造 ROLE_ADMIN 的令牌
# 绕过全部鉴权 —— 所以它绝不能进版本库。

# JWT 签名密钥（HS256）。至少 32 字符。
JWT_SECRET=

# 本地 MySQL 密码
DB_PASSWORD=
