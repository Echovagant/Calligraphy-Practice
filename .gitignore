# Maven 构建产物
SpringBoot-Platform/target/
*.class

# 上传的文件（运行时生成，不入库）
SpringBoot-Platform/uploads/
uploads/

# 本地密钥（由 run-local.ps1 读入并注入环境变量，绝不入库）
SpringBoot-Platform/config/local-secrets.properties

# Python 缓存
__pycache__/
*.pyc

# 运行日志
*.log
app.log*

# 编码修复工具的输出报告（可由 scripts/mojibake.py 重新生成）
docs/mojibake-unresolved.md
SpringBoot-Platform/message-check-report.txt

# 契约一致性检查的输出（可由 scripts/check-contract.mjs 重新生成）
Practice-Platform/openapi/contract-diff.md

# 验证脚本的输出
.verify-*.txt
.javac-*.txt
.oracle-*.txt
.apply-*.txt

# IDE
.idea/
*.iml
.vscode/settings.json

# OS
.DS_Store
Thumbs.db

# 本地项目计划书（Word 文档，不入库）
/在线书法练习平台项目计划书.docx

# 本地运行手册（记本机启动/停止命令，不入库）
/Run.md

# 本机工具配置（含本机路径与命令白名单，只对本机有意义）
/config.json

# 开发流程文档（计划 / 设计存档，不入库）
/docs/superpowers/

# AI 工具生成的本机文档
/.trae/

# 前端构建期自动生成的类型声明（vite.config.js 已设 dts: false，此项兜底）
Practice-Platform/components.d.ts
Practice-Platform/auto-imports.d.ts
