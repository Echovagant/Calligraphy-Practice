# Maven 构建产物
SpringBoot-Platform/target/
*.class

# 上传的文件（运行时生成，不入库）
SpringBoot-Platform/uploads/
uploads/

# 本地密钥（由 run-local.ps1 读入并注入环境变量，绝不入库）
SpringBoot-Platform/config/local-secrets.properties

# Python 缓存
__pycache__/
*.pyc

# 运行日志
*.log
app.log*

# 编码修复工具的输出报告（可由 scripts/mojibake.py 重新生成）
docs/mojibake-unresolved.md
SpringBoot-Platform/message-check-report.txt

# 契约一致性检查的输出（可由 scripts/check-contract.mjs 重新生成）
Practice-Platform/openapi/contract-diff.md

# 验证脚本的输出
.verify-*.txt
.javac-*.txt
.oracle-*.txt
.apply-*.txt

# IDE
.idea/
*.iml
.vscode/settings.json

# OS
.DS_Store
Thumbs.db
